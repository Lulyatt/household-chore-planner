# PostgreSQL connection string (copy to `.env` and adjust for your machine).
# Example matches the optional docker-compose service in this repo.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/household_chore_planner?schema=public"

# Auth.js (NextAuth v5). Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Optional in local dev; set in production to your public app URL.
# AUTH_URL="http://localhost:3000"

# Vercel Blob — completion photo uploads (server-side). Create a Blob store in the
# Vercel dashboard (Storage → Blob) or run `vercel blob` locally; copy the read-write token.
# Without this token, completions still work with a note only.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace_me"
